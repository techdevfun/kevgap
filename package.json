{"author":"TECHDEV","bin":{"kevgap":"./dist/cli.js"},"description":"A zero-dependency CLI that measures the KEV exposure gap: the days between a vulnerability being listed on CISA KEV and it actually being fixed in your estate, and gates CI on the KEV due date.","devDependencies":{"@eslint/js":"^10.0.1","@types/node":"^22.20.5","eslint":"^10.15.0","globals":"^16.5.0","prettier":"^3.10.1","typescript":"^5.9.3","typescript-eslint":"^8.72.2"},"engines":{"node":">=20"},"keywords":["cli","cisa-kev","kev","vulnerability","patch-management","security","audit","ci-gate","kevgap"],"license":"MIT","name":"kevgap","repository":{"type":"git","url":"https://github.com/techdevfun/kevgap.git"},"scripts":{"build":"tsc","format":"prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"","lint":"eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"","preflight":"node scripts/preflight.js","test":"npm run build && node --test test/unit.test.js test/e2e.test.js","test:live":"node --test test/live.test.js"},"type":"module","version":"0.1.0"}